{
  "name": "10 - AUDIOBOOK FACTORY",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://audiobook-factory:8080/scan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUDIOBOOK_FACTORY_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        240,
        0
      ],
      "name": "Scan Audiobook Inbox",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://audiobook-factory:8080/process-queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUDIOBOOK_FACTORY_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        480,
        0
      ],
      "name": "Start Jobs Async",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://audiobook-factory:8080/events/pending",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUDIOBOOK_FACTORY_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        720,
        0
      ],
      "name": "Fetch Pending Events",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const scan = $('Scan Audiobook Inbox').first().json || {};\nconst queue = $('Start Jobs Async').first().json || {};\nconst pending = $json || {};\nconst now = new Date().toISOString();\nconst items = [];\n\nconst events = Array.isArray(pending.events) ? pending.events : [];\nfor (const ev of events) {\n  items.push({\n    json: {\n      should_emit: true,\n      source: ev.source || 'audiobook_factory',\n      severity: ev.severity || 'info',\n      component: ev.component || 'audiobook',\n      event: ev.event,\n      status: ev.status,\n      timestamp: now,\n      message: ev.message,\n      requires_attention: !!ev.requires_attention,\n      suggested_action: ev.suggested_action ?? null,\n      details: {\n        job_id: ev.details?.job_id ?? null,\n        title: ev.details?.title ?? null,\n        author: ev.details?.author ?? null,\n        format: ev.details?.format ?? null,\n        chapters: ev.details?.chapters ?? null,\n        progress: ev.details?.progress ?? null,\n        duration: ev.details?.duration ?? null,\n        output_path: ev.details?.output_path ?? null,\n        processing_time: ev.details?.processing_time ?? null,\n        error_code: ev.details?.error_code ?? null,\n        error_message: ev.details?.error_message ?? null,\n        // NÃO incluir texto do livro / capítulos / conteúdo\n      },\n      ack: { job_id: ev.job_id, event_key: ev.event_key },\n      scan_summary: {\n        scanned: scan.scanned ?? 0,\n        registered: scan.registered ?? 0,\n        skipped: scan.skipped ?? 0,\n        queue_started: !!queue.started,\n        queue_job_id: queue.job_id ?? null,\n      },\n    },\n  });\n}\n\nif (!items.length) {\n  items.push({\n    json: {\n      should_emit: false,\n      scan_summary: {\n        scanned: scan.scanned ?? 0,\n        registered: scan.registered ?? 0,\n        skipped: scan.skipped ?? 0,\n        queue_started: !!queue.started,\n      },\n    },\n  });\n}\n\nreturn items;\n",
        "mode": "runOnceForAllItems"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "name": "Prepare Event"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.should_emit }}",
              "value2": true
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "name": "Has Events?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{$env.N8N_WEBHOOK_BASE}}/webhook/hestia-event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  source: $json.source,\n  severity: $json.severity,\n  component: $json.component,\n  event: $json.event,\n  status: $json.status,\n  timestamp: $json.timestamp,\n  message: $json.message,\n  details: $json.details,\n  requires_attention: $json.requires_attention,\n  suggested_action: $json.suggested_action\n}\n}}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1440,
        -80
      ],
      "name": "Hestia Event Bus",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://audiobook-factory:8080/events/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUDIOBOOK_FACTORY_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { acks: [$json.ack] } }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1680,
        -80
      ],
      "name": "Ack Events",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Scan Audiobook Inbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan Audiobook Inbox": {
      "main": [
        [
          {
            "node": "Start Jobs Async",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Jobs Async": {
      "main": [
        [
          {
            "node": "Fetch Pending Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pending Events": {
      "main": [
        [
          {
            "node": "Prepare Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Event": {
      "main": [
        [
          {
            "node": "Has Events?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Events?": {
      "main": [
        [
          {
            "node": "Hestia Event Bus",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Hestia Event Bus": {
      "main": [
        [
          {
            "node": "Ack Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "timezone": "America/Sao_Paulo"
  },
  "meta": {
    "templateSource": "VinyLab-Automation-Hub",
    "sanitized": true
  },
  "pinData": {},
  "active": false
}
