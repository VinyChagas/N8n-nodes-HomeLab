{
  "name": "20 - INCIDENT CORRELATION ENGINE",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Every 1 Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{$env.OMEAB_SERVICE_URL}}/v1/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.OMEAB_HEALTH_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Run Correlation Process",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json || {};\nconst notes = Array.isArray(data.notifications) ? data.notifications : [];\nif (!notes.length) {\n  return [{ json: { should_notify: false, skip: true, meta: {\n    processed_events: data.processed_events || 0,\n    ignored_events: data.ignored_events || 0,\n    lock_acquired: data.lock_acquired,\n    bootstrap: data.bootstrap,\n    execution_time_ms: data.execution_time_ms,\n  }}}];\n}\nreturn notes.map((ev) => ({\n  json: {\n    should_notify: true,\n    source: ev.source || 'incident_correlation_engine',\n    severity: ev.severity || 'info',\n    component: ev.component || 'incident_management',\n    event: ev.event,\n    status: ev.status || 'open',\n    timestamp: ev.timestamp || new Date().toISOString(),\n    message: ev.message || ev.event,\n    details: ev.details || {},\n    requires_attention: !!ev.requires_attention,\n    suggested_action: ev.suggested_action || null,\n  }\n}));\n"
      },
      "name": "Expand Notifications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "f54d43c9-438a-440f-b425-502bd25a6ea4",
              "leftValue": "={{ $json.should_notify }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Should Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{$env.N8N_WEBHOOK_BASE}}/webhook/hestia-event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: $json.source, severity: $json.severity, component: $json.component, event: $json.event, status: $json.status, timestamp: $json.timestamp, message: $json.message, details: $json.details, requires_attention: $json.requires_attention, suggested_action: $json.suggested_action }) }}",
        "options": {}
      },
      "name": "Send to Hestia Event Bus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        300
      ]
    }
  ],
  "connections": {
    "Every 1 Minute": {
      "main": [
        [
          {
            "node": "Run Correlation Process",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Run Correlation Process",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Correlation Process": {
      "main": [
        [
          {
            "node": "Expand Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expand Notifications": {
      "main": [
        [
          {
            "node": "Should Notify?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Notify?": {
      "main": [
        [
          {
            "node": "Send to Hestia Event Bus",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "templateSource": "VinyLab-Automation-Hub",
    "sanitized": true
  },
  "pinData": {},
  "active": false
}
