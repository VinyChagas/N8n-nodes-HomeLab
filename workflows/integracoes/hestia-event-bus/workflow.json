    {
      "parameters": {
        "jsCode": "const event = $json;\n\nconst icons = {\n  error: '🔴',\n  critical: '🚨'\n};\n\nconst labels = {\n  error: 'ERRO',\n  critical: 'CRÍTICO'\n};\n\nconst severity = event.severity;\n\nreturn [{\n  json: {\n    ...event,\n\n    alert: {\n      type: 'HESTIA_SYSTEM_ALERT',\n      priority: severity === 'critical' ? 'urgent' : 'high',\n\n      title: `${icons[severity] ?? '⚠️'} ${labels[severity] ?? severity.toUpperCase()} — ${event.component}`,\n\n      text: [\n        `${icons[severity] ?? '⚠️'} HESTIA — ${labels[severity] ?? severity.toUpperCase()}`,\n        '',\n        `Componente: ${event.component}`,\n        `Evento: ${event.event}`,\n        `Status: ${event.status}`,\n        '',\n        event.message,\n        '',\n        event.suggested_action\n          ? `Ação sugerida: ${event.suggested_action}`\n          : null,\n        '',\n        `Origem: ${event.source}`,\n        `ID: ${event.correlation_id}`\n      ].filter(line => line !== null).join('\\n')\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        224
      ],
      "name": "Prepare Alert"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst event = $json;\n\n// Secret armazenado no ambiente do n8n.\n// Nunca fica gravado dentro do workflow.\nconst secret = $env.HESTIA_WEBHOOK_SECRET;\n\nif (!secret) {\n  throw new Error('HESTIA_WEBHOOK_SECRET não está disponível no ambiente do n8n.');\n}\n\n// O Hermes espera que o body possua alert.text.\n// Serializamos UMA ÚNICA VEZ.\n// Esta mesma string deverá ser enviada pelo HTTP Request.\nconst body = JSON.stringify({\n  alert: {\n    text: event.alert.text\n  }\n});\n\n// Unix timestamp em segundos\nconst timestamp = String(Math.floor(Date.now() / 1000));\n\n// Hermes HMAC V2:\n// timestamp + \".\" + RAW BODY\nconst canonicalPayload = `${timestamp}.${body}`;\n\n// HMAC-SHA256 → hexadecimal minúsculo\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(canonicalPayload, 'utf8')\n  .digest('hex');\n\nreturn [\n  {\n    json: {\n      ...event,\n\n      hermes_request: {\n        body,\n        timestamp,\n        signature\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
