      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\n\nconst allowedSeverities = [\n  'info',\n  'warning',\n  'error',\n  'critical'\n];\n\nlet severity = String(\n  input.severity ?? 'info'\n).toLowerCase();\n\nif (!allowedSeverities.includes(severity)) {\n  severity = 'info';\n}\n\nconst now = new Date().toISOString();\n\nconst correlationId =\n  input.correlation_id ??\n  `${input.source ?? 'unknown'}-${Date.now()}`;\n\nreturn [\n  {\n    json: {\n      source: input.source ?? 'unknown',\n      severity: severity,\n      component: input.component ?? 'unknown',\n      event: input.event ?? 'unknown_event',\n      status: input.status ?? 'active',\n\n      timestamp: input.timestamp ?? now,\n\n      message:\n        input.message ??\n        'Evento recebido sem descrição.',\n\n      details:\n        input.details ?? {},\n\n      correlation_id:\n        correlationId,\n\n      requires_attention:\n        input.requires_attention ?? false,\n\n      suggested_action:\n        input.suggested_action ?? null,\n\n      received_at: now,\n\n      event_bus: {\n        name: 'HESTIA_EVENT_BUS',\n        version: '1.0'\n      }\n    }\n  }\n];"
      },
