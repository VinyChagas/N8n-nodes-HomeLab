# Copie para .env local do n8n (nunca commitar .env real)

# URL base dos seus serviços de health/monitoramento
SERVICE_BASE_URL=http://127.0.0.1:8710

# Serviços OMEAB (ajuste portas conforme seu compose)
OMEAB_SERVICE_URL=http://127.0.0.1:18790

# Hermes / assistente
HERMES_URL=http://127.0.0.1:8642/webhook

# Segredos (gere valores novos — não reutilize produção)
HESTIA_WEBHOOK_SECRET=change-me-long-random
HESTIA_ACTION_SECRET=change-me-long-random
OMEAB_HEALTH_TOKEN=change-me-long-random
AUTH_TOKEN=change-me-long-random
SECRET=change-me-long-random

# n8n
N8N_HOST=127.0.0.1
WEBHOOK_URL=http://127.0.0.1:5678/
GENERIC_TIMEZONE=America/Sao_Paulo

# Base interna para callbacks ao Event Bus
N8N_WEBHOOK_BASE=http://n8n:5678
